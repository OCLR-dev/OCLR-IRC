{
  "name": "oclr-ref-tools",
  "version": "0.7.0",
  "private": true,
  "description": "OCLR referee desktop \u2014 IRC chat workspace",
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "contracts:oclr": "node --experimental-strip-types scripts/export-oclr-contracts.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "npm run build && node scripts/run-smoke.cjs",
    "package:mac": "npm run build && node scripts/package-mac.cjs",
    "package:win": "npm run build && electron-packager . \"OCLR IRC\" --platform=win32 --out=release --overwrite --ignore=^/release --ignore=^/spikes --ignore=^/docs --ignore=^/tests --ignore=^/src --ignore=^/scripts --ignore=^/artifacts",
    "package:linux": "npm run build && node scripts/package-linux.cjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "i18next": "26.5.12",
    "linkify-react": "4.4.0",
    "linkifyjs": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-virtuoso": "4.18.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
